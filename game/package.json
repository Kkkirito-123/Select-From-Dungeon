{
  "name": "select-from-dungeon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "benchmark:adapter": "node ../scripts/benchmark-adapter.mjs",
    "question-bank:build": "node scripts/build-question-bank.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node node_modules/vitest/vitest.mjs run tests --no-file-parallelism",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "check": "pnpm test && pnpm build"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "sql.js": "1.14.1",
    "xstate": "5.32.5"
  },
  "devDependencies": {
    "@types/sql.js": "1.4.10",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
