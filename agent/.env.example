# 复制为 agent/.env 后填写；Python 服务不会自动读取此示例文件。
DEEPSEEK_API_KEY=your-child-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT=12
DEEPSEEK_MAX_TOKENS=500

# 主 Agent 独立配置；没有 Key 时使用确定性综合。
DIRECTOR_API_KEY=your-director-api-key
DIRECTOR_MODEL=deepseek-chat
DIRECTOR_URL=https://api.deepseek.com/chat/completions
DIRECTOR_TIMEOUT=4
DIRECTOR_MAX_TOKENS=320

# 可选 OTLP/HTTP Collector；留空时不向外部发送 Trace。
OTEL_EXPORTER_OTLP_ENDPOINT=
