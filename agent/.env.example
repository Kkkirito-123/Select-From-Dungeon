# 复制为 agent/.env 后填写；Python 服务不会读取此示例文件。
CHILD_API_KEY=your-child-api-key
CHILD_MODEL=deepseek-chat
CHILD_URL=https://api.deepseek.com/chat/completions
CHILD_TIMEOUT=12
CHILD_MAX_TOKENS=500

# 主 Agent 独立配置；没有 Key 时使用确定性综合。
MAIN_API_KEY=your-main-api-key
MAIN_MODEL=deepseek-chat
MAIN_URL=https://api.deepseek.com/chat/completions
MAIN_TIMEOUT=4
MAIN_MAX_TOKENS=320

# 可选 OTLP/HTTP Collector；留空时不向外部发送 Trace。
OTEL_EXPORTER_OTLP_ENDPOINT=
